{
  "name": "@agents/captain-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm check:boundaries && pnpm test && pnpm typecheck && pnpm build",
    "check:boundaries": "node scripts/check-dependency-boundaries.mjs",
    "eve:info": "pnpm --filter @agents/captain eve:info",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
