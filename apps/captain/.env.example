# Eve and public URLs
AI_MODEL=openai/gpt-5.6-terra
# Separate Vercel Gateway key for the Captain service.
# AI_GATEWAY_API_KEY=
CAPTAIN_PUBLIC_URL=http://127.0.0.1:4178

# Public Captain Telegram bot. Every private Telegram user can start a Trip.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET_TOKEN=
# CAPTAIN_SESSION_SECRET=generate-a-long-random-secret

# Production persistence. Local development falls back to an in-memory store.
# DATABASE_URL=postgresql://...
# Eve conversation/workflow persistence. Use the Captain database, ideally
# through its dedicated Workflow role rather than Pilot's connection.
# WORKFLOW_POSTGRES_URL=postgresql://...

# Duffel owns all live fare searches in this service.
# DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_LIVE_MODE=false
DUFFEL_SUPPLIER_TIMEOUT_MS=20000
FLIGHT_SEARCH_TIMEOUT_MS=120000

# Owner access. Required in production; local requests are trusted.
CAPTAIN_BASIC_USERNAME=captain
# Set false only when intentionally exposing the owner UI and API publicly.
CAPTAIN_OWNER_AUTH_ENABLED=true
# CAPTAIN_BASIC_PASSWORD=

# Signed Pilot ↔ Captain bridge. Use distinct random values.
PILOT_BASE_URL=http://127.0.0.1:8081
# PILOT_TO_CAPTAIN_SECRET=
# CAPTAIN_TO_PILOT_SECRET=

# Codex is not installed here. Fare-plus-research requests cross the signed
# Pilot bridge; normal creation, refresh, and opportunistic checks are fare-only.

# Workflow Postgres uses the same database with an isolated namespace.
WORKFLOW_POSTGRES_JOB_PREFIX=captain_eve
WORKFLOW_POSTGRES_WORKER_CONCURRENCY=4
WORKFLOW_POSTGRES_MAX_POOL_SIZE=8
