# Eve and public URLs
AI_MODEL=openai/gpt-5.6-terra
TRIP_INTERPRETER_MODEL=openai/gpt-5.6-luna
# Vercel Gateway key used by Eve for conversational trip setup.
# AI_GATEWAY_API_KEY=
CAPTAIN_PUBLIC_URL=http://127.0.0.1:4178
CAPTAIN_PUBLIC_BETA_ENABLED=true
CAPTAIN_BETA_USER_LIMIT=25

# Public Captain Telegram bot. Every private Telegram user can start a trip.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Production persistence. Local development falls back to an in-memory store.
# DATABASE_URL=postgresql://...
# Schema migrations use a separate member of captain_migrator.
# MIGRATION_DATABASE_URL=postgresql://...
# Set to 1 only to install the baseline into a database that has no Captain
# project yet. Leave it unset so the sentinel check stays the guard.
# CAPTAIN_ALLOW_BASELINE=1
# SOURCE_CAPTAIN_DATABASE_URL=postgresql://...
# TARGET_CAPTAIN_DATABASE_URL=postgresql://...
# Eve conversation/workflow persistence. Use Captain's dedicated Workflow role.
# WORKFLOW_POSTGRES_URL=postgresql://...

# Workflow Postgres uses the same database with an isolated namespace.
WORKFLOW_POSTGRES_JOB_PREFIX=captain_eve
WORKFLOW_POSTGRES_WORKER_CONCURRENCY=4
WORKFLOW_POSTGRES_MAX_POOL_SIZE=8
