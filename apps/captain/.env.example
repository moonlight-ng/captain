# Eve and public URLs
AI_MODEL=anthropic/claude-sonnet-5
TRIP_INTERPRETER_MODEL=openai/gpt-5.6-luna
TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe
CAPTAIN_LANGUAGE_MODEL=openai/gpt-5.6-luna
# Vercel Gateway key used by Eve for conversational trip setup.
# AI_GATEWAY_API_KEY=
CAPTAIN_PUBLIC_URL=http://127.0.0.1:4178
# Reversible shutdown switch. It closes Telegram and public traveller writes,
# disables external model/provider work, and leaves admin/read-only data intact.
CAPTAIN_ARCHIVED_MODE=false
CAPTAIN_PUBLIC_BETA_ENABLED=true
CAPTAIN_BETA_USER_LIMIT=25
# Enables the Trip → City → Flight composition and manual leg-search APIs.
CAPTAIN_SIMPLIFIED_MULTI_CITY_ENABLED=true

# Private, channel-independent administrator sign-in. The publishable key is
# intentionally safe to return to the browser; Captain data remains server-only.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# CAPTAIN_ADMIN_EMAILS=owner@example.com

# Daily private review of the previous Lagos calendar day's conversations.
CAPTAIN_CONVERSATION_REVIEW_ENABLED=false
CAPTAIN_CONVERSATION_REVIEW_TIME_ZONE=Africa/Lagos
CAPTAIN_CONVERSATION_REVIEW_MODEL=openai/gpt-5.6-luna
CAPTAIN_CONVERSATION_REVIEW_RECIPIENTS=owner@example.com,reviewer@example.com
# Optional direct-Resend fallback when the Pilot bridge below is absent.
# The sender must use a domain verified by the configured Resend account.
# CAPTAIN_CONVERSATION_REVIEW_FROM=Captain <captain@example.com>
# RESEND_API_KEY=

# Public Captain Telegram bot. Every private Telegram user can start a trip.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Signed, one-way Pilot ingress for Telegram feedback and owner-only review
# email delivery. Configure both values together.
# FEEDBACK_BRIDGE_URL=https://pilot.example.com
# FEEDBACK_BRIDGE_SECRET=

# Production persistence. Local development falls back to an in-memory store.
# DATABASE_URL=postgresql://...
# Schema migrations use a separate member of captain_migrator.
# MIGRATION_DATABASE_URL=postgresql://...
# Set to 1 only to install the baseline into a database that has no Captain
# project yet. Leave it unset so the sentinel check stays the guard.
# CAPTAIN_ALLOW_BASELINE=1
# SOURCE_CAPTAIN_DATABASE_URL=postgresql://...
# TARGET_CAPTAIN_DATABASE_URL=postgresql://...
# Eve conversation/workflow persistence. Use Captain's dedicated Workflow role.
# WORKFLOW_POSTGRES_URL=postgresql://...

# DUFFEL_ACCESS_TOKEN=
# DUFFEL_BASE_URL=https://api.duffel.com

# Workflow Postgres uses the same database with an isolated namespace.
WORKFLOW_POSTGRES_JOB_PREFIX=captain_eve
WORKFLOW_POSTGRES_WORKER_CONCURRENCY=4
WORKFLOW_POSTGRES_MAX_POOL_SIZE=8
