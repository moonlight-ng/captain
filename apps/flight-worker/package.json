{
  "name": "@agents/flight-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc --noEmit",
    "eval:live": "node --env-file-if-exists=.env --import tsx src/evaluate.ts",
    "diagnose:search": "node --env-file-if-exists=.env --import tsx src/diagnose.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agents/flight-domain": "workspace:*",
    "@agents/flight-store": "workspace:*",
    "@agents/observability": "workspace:*",
    "@agents/provider-duffel": "workspace:*",
    "@agents/provider-flysoar": "workspace:*",
    "@agents/telegram-core": "workspace:*",
    "postgres": "3.4.7",
    "tsx": "4.22.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
